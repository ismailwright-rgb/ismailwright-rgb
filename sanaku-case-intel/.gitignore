# Per-firm config — never committed, this is where client identity/branding lives.
config/client.json
config/assets/
config/license.key

# All case data — client documents, vector indexes. Never leaves the box,
# never enters version control either.
data/

# Dev-only virtualenv used to install requirements.txt + requirements-dev.txt.
.venv-dev/

# scripts/dev.sh's log files for the API/UI/voice servers it starts.
.dev-api.log
.dev-ui.log
.dev-piper.log

__pycache__/
*.pyc
.pytest_cache/

# scripts/package-release.sh's output — rebuilt on demand, not a source file.
dist/

# scripts/new-client.sh backs up a pre-existing config/client.json here
# before overwriting it — never a source file, and per-firm like the
# thing it's a backup of.
config/client.json.bak-*

# The repo root's own .gitignore excludes .claude/ broadly (personal/
# local Claude Code session config, sensible as a repo-wide default).
# These two files are the exception: project-scoped slash commands,
# deliberately meant to be tracked and shipped with every client bundle
# (see docs/new-client-playbook.md's "Slash commands" section) - not
# personal config.
!.claude/
!.claude/commands/
!.claude/commands/*.md
