# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and dockerignored - keep it that way.
# ---------------------------------------------------------------------------

# --- Alpaca ----------------------------------------------------------------
# Paper keys start with PK. Generate them at https://app.alpaca.markets (Paper tab).
ALPACA_KEY_ID=PK_your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Trading endpoint. Leave this alone unless you genuinely mean to trade real money.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Market data feed. "iex" is the free plan. "sip" needs a paid subscription and
# gives full consolidated volume, which makes RVOL and VWAP meaningfully better.
ALPACA_DATA_FEED=iex

# Live trading is refused unless this is exactly "true" AND the trading URL is
# not the paper host. Both conditions, deliberately.
ALLOW_LIVE=false

# --- LLM (optional) --------------------------------------------------------
# Without a key the dashboard still runs: it scores the technicals and shows
# headlines, but skips the written reasoning and the news veto.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Risk limits (server-enforced; the browser cannot override these) -------
WATCHLIST=GRAB,PLUG,GLD,SLV,CPER,SPY,QQQ,AAPL,MSFT,NVDA,FCX,NEM,CAT,AMZN,GOOGL,META,JPM,XOM
RISK_PCT_PER_TRADE=0.5        # percent of equity risked between entry and stop
MAX_NOTIONAL_PER_ORDER=500    # hard USD cap on a single position
MAX_OPEN_POSITIONS=4
MIN_SCORE_TO_TRADE=70         # composite score required before Execute unlocks
MAX_SPREAD_BPS=25             # skip anything wider; day trades die on spread
MIN_MINUTES_TO_CLOSE=30       # no new entries inside this window before the bell
MAX_ANALYSIS_AGE_SECONDS=600  # stale analysis cannot be traded on
TARGET_R_MULTIPLE=2           # take-profit distance as a multiple of the stop

# --- Server ----------------------------------------------------------------
PORT=8080
# Basic auth for the dashboard. Leave DASHBOARD_USER empty to disable (only safe
# when bound to 127.0.0.1, which is the compose default).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
TZ=America/New_York
