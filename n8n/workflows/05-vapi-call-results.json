          "name": "SMTP Account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "notify",
              "leftValue": "={{ ['interested', 'callback'].includes($('Merge Prospect').first().json.outcome) }}",
              "rightValue": "",
