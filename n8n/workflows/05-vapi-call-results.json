        "fromEmail": "={{ $env.DIGEST_FROM_EMAIL }}",
        "toEmail": "={{ $env.DIGEST_TO_EMAIL }}",
        "subject": "=[{{ $('Merge Prospect').first().json.outcome }}] {{ $('Merge Prospect').first().json.company_name }} - act on this lead",
        "emailFormat": "html",
        "html": "=<h3>{{ $('Merge Prospect').first().json.company_name }} ({{ $('Merge Prospect').first().json.domain }})</h3><p><strong>Outcome:</strong> {{ $('Merge Prospect').first().json.outcome }}<br><strong>Contact:</strong> {{ $('Merge Prospect').first().json.contact_name || '-' }} / {{ $('Merge Prospect').first().json.contact_email || '-' }} / {{ $('Merge Prospect').first().json.contact_phone || '-' }}<br><strong>Duration:</strong> {{ $('Merge Prospect').first().json.duration_seconds || '?' }}s</p><p><strong>Call summary:</strong></p><blockquote>{{ $('Merge Prospect').first().json.summary || '(no summary)' }}</blockquote><p>Recording: {{ $('Merge Prospect').first().json.recording_url || '(none)' }}</p>",
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000017",
      "name": "Notify Me",
      "type": "n8n-nodes-base.emailSend",
