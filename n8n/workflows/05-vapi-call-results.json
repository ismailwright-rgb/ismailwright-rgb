        "jsonBody": "={{ JSON.stringify({ domain: $('Merge Prospect').first().json.domain, email: $('Merge Prospect').first().json.contact_email, phone: $('Merge Prospect').first().json.contact_phone, reason: 'asked not to be called (vapi outreach)' }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "e5000000-0000-4000-8000-000000000013",
      "name": "Add To Suppression",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2340, 260],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-header-auth",
          "name": "Supabase Service Role (Header Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "follow-up",
              "leftValue": "={{ ['interested', 'voicemail'].includes($('Merge Prospect').first().json.outcome) && !!$('Merge Prospect').first().json.contact_email }}",
              "rightValue": "",
