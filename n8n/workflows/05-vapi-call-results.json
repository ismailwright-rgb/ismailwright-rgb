      "id": "e5000000-0000-4000-8000-000000000014",
      "name": "Follow Up Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2560, 360]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.DIGEST_FROM_EMAIL }}",
        "toEmail": "={{ $('Merge Prospect').first().json.contact_email }}",
        "subject": "=Following up on our call - {{ $('Merge Prospect').first().json.company_name }}",
        "emailFormat": "html",
        "html": "=<p>Hi {{ $('Merge Prospect').first().json.contact_name || 'there' }},</p><p>Thanks for taking the time today - this is a quick follow-up from our call to {{ $('Merge Prospect').first().json.company_name }}.</p><p>We help businesses like yours automate appointment booking, lead follow-up, and front-desk calls with AI so you never miss a customer. I'd love to show you a quick demo tailored to your business.</p><p>Just reply to this email and I'll set something up at a time that works for you.</p><p>Best,<br>Ismail</p><p style=\"color:#888;font-size:12px;\">If you'd rather not hear from us again, just reply with \"unsubscribe\" and we'll remove you immediately.</p>",
        "options": {}
      },
