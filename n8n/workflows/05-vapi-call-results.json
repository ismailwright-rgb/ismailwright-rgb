            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000002",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [360, 560]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"unauthorized\" }",
        "options": { "responseCode": 401 }
      },
      "id": "e5000000-0000-4000-8000-000000000003",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [580, 760]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": { "responseCode": 200 }
      },
      "id": "e5000000-0000-4000-8000-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [580, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "eocr",
              "leftValue": "={{ $json.body && $json.body.message && $json.body.message.type === 'end-of-call-report' }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5000000-0000-4000-8000-000000000005",
      "name": "Is End Of Call Report?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [800, 460]
    },
    {
      "parameters": {},
      "id": "e5000000-0000-4000-8000-000000000006",
      "name": "Ignore Other Events",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1020, 620]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Map the Vapi end-of-call-report to an outcome + outreach status.\nconst msg = $input.first().json.body.message;\nconst call = msg.call || {};\nconst prospectId = (call.metadata && call.metadata.prospect_id) || (msg.metadata && msg.metadata.prospect_id) || null;\nconst analysis = msg.analysis || {};\nconst structured = analysis.structuredData || {};\nconst summary = String(analysis.summary || msg.summary || '');\nconst endedReason = String(msg.endedReason || call.endedReason || '');\n\n// Prefer a structured outcome from the assistant's analysis schema; fall back to keywords.\nlet outcome = String(structured.outcome || '').toLowerCase().replace(/[^a-z_]/g, '_');\nconst VALID = ['interested', 'callback', 'not_interested', 'voicemail', 'asked_not_to_call', 'no_answer', 'contacted'];\nif (!VALID.includes(outcome)) {\n  const s = summary.toLowerCase();\n  if (/do not call|don't call|stop calling|remove (me|us)|take (me|us) off/.test(s)) outcome = 'asked_not_to_call';\n  else if (/interested|wants? (a )?(demo|meeting|quote|follow[- ]?up)|schedule[sd]? (a )?(call|meeting)/.test(s)) outcome = 'interested';\n  else if (/call (them |me |us )?back|callback|better time|try again/.test(s)) outcome = 'callback';\n  else if (/not interested|declined|no thanks/.test(s)) outcome = 'not_interested';\n  else if (/voicemail|left a message/.test(s) || /voicemail/i.test(endedReason)) outcome = 'voicemail';\n  else if (/no answer|did not (pick|answer)|busy/.test(s) || /(no-answer|busy)/i.test(endedReason)) outcome = 'no_answer';\n  else outcome = 'contacted';\n}\n\nconst statusMap = {\n  interested: 'interested',\n  callback: 'callback',\n  not_interested: 'not_interested',\n  asked_not_to_call: 'do_not_call',\n  voicemail: 'contacted',\n  no_answer: 'contacted',\n  contacted: 'contacted',\n};\n\nlet durationSeconds = null;\nif (typeof msg.durationSeconds === 'number') durationSeconds = Math.round(msg.durationSeconds);\nelse if (msg.startedAt && msg.endedAt) durationSeconds = Math.max(0, Math.round((new Date(msg.endedAt) - new Date(msg.startedAt)) / 1000));\n\nreturn [{\n  json: {\n    prospect_id: prospectId,\n    vapi_call_id: call.id || null,\n    outcome,\n    outreach_status: statusMap[outcome] || 'contacted',\n    ended_reason: endedReason || null,\n    duration_seconds: durationSeconds,\n    cost: typeof msg.cost === 'number' ? msg.cost : null,\n    summary: summary.slice(0, 4000) || null,\n    transcript: String(msg.transcript || '').slice(0, 20000) || null,\n    recording_url: msg.recordingUrl || (msg.artifact && msg.artifact.recordingUrl) || null,\n    ended_at: msg.endedAt || new Date().toISOString(),\n  },\n}];"
      },
      "id": "e5000000-0000-4000-8000-000000000007",
      "name": "Parse Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 360]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/prospects?id=eq.{{ $json.prospect_id }}&select=company_name,contact_name,contact_email,contact_phone,domain,vertical",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "id": "e5000000-0000-4000-8000-000000000008",
      "name": "Get Prospect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 360],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-header-auth",
          "name": "Supabase Service Role (Header Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Combine the parsed call outcome with the prospect record.\nconst parsed = $('Parse Outcome').first().json;\nconst p = $input.first().json || {};\nreturn [{\n  json: {\n    ...parsed,\n    company_name: p.company_name || null,\n    contact_name: p.contact_name || null,\n    contact_email: p.contact_email || null,\n    contact_phone: p.contact_phone || null,\n    domain: p.domain || null,\n    vertical: p.vertical || null,\n  },\n}];"
      },
      "id": "e5000000-0000-4000-8000-000000000009",
      "name": "Merge Prospect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1460, 360]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/outreach_log?vapi_call_id=eq.{{ $json.vapi_call_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'completed', outcome: $json.outcome, ended_reason: $json.ended_reason, duration_seconds: $json.duration_seconds, cost: $json.cost, summary: $json.summary, transcript: $json.transcript, recording_url: $json.recording_url, ended_at: $json.ended_at }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "e5000000-0000-4000-8000-000000000010",
      "name": "Update Outreach Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 360],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-header-auth",
          "name": "Supabase Service Role (Header Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/prospects?id=eq.{{ $('Merge Prospect').first().json.prospect_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ outreach_status: $('Merge Prospect').first().json.outreach_status }, $('Merge Prospect').first().json.outcome === 'asked_not_to_call' ? { do_not_contact: true } : {})) }}",
        "options": { "timeout": 15000 }
      },
      "id": "e5000000-0000-4000-8000-000000000011",
      "name": "Update Prospect Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 360],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-header-auth",
