# Copy to .env (never commit .env). These are the PUBLIC anon values -
# the dashboard authenticates through Supabase Auth; RLS does the guarding.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL for n8n webhooks, used by the "Invite" button on the Clients page.
# No secret here - the invite endpoint verifies the caller's own Supabase
# session token server-side and checks they are staff before doing anything.
VITE_N8N_WEBHOOK_BASE=http://your-n8n-host:5678/webhook
