      ]
    },
    "Set Replied": {
      "main": [ [ { "node": "Worth An Alert?", "type": "main", "index": 0 } ] ]
    },
    "Worth An Alert?": {
      "main": [
        [ { "node": "Alert Me", "type": "main", "index": 0 } ],
        [ { "node": "Done", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Los_Angeles"
  },
  "pinData": {},
