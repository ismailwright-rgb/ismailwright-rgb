    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Record what went out, and clear the draft so the record cannot be\n// re-approved and re-sent by accident.\nconst e = $('Build The Email').first().json;\nreturn [{ json: {\n  id: e.id,\n  conversation: {\n    prospect_id: e.id,\n    direction: 'outbound',\n    channel: 'email',\n    subject: e.subject,\n    body: e.text,\n    sequence_step: e.step,\n    sent_at: new Date().toISOString(),\n  },\n  prospect: {\n    status: 'contacted',\n    last_contacted: new Date().toISOString(),\n    last_activity_at: new Date().toISOString(),\n    draft_subject: null,\n    draft_body: null,\n    draft_step: null,\n    draft_angle: null,\n    draft_generated_at: null,\n  },\n} }];"
      },
