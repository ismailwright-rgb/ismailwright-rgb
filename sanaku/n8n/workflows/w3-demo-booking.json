    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 30-min slots, weekdays 10:00-16:00 America/Los_Angeles, next 10 business\n// days, minus busy blocks, nothing inside the next 24h.\nconst resp = $input.first().json || {};\nconst busy = ((resp.calendars || {}).primary || {}).busy || [];\nconst busyRanges = busy.map((b) => [new Date(b.start).getTime(), new Date(b.end).getTime()]);\n\nconst TZ = 'America/Los_Angeles';\nconst tzOffsetMs = (d) => d.getTime() - new Date(d.toLocaleString('en-US', { timeZone: TZ })).getTime() + (d.getTime() - new Date(d.toLocaleString('en-US', { timeZone: 'UTC' })).getTime()) * 0;\n// Simpler: build a Date for a wall-clock time in TZ by iterating candidate offsets.\nfunction wallClockToUtc(y, mo, day, h, mi) {\n  // try each plausible PT offset; pick the one that round-trips\n  for (const off of [7, 8]) {\n    const guess = Date.UTC(y, mo, day, h + off, mi);\n    const d = new Date(guess);\n    const parts = new Intl.DateTimeFormat('en-US', { timeZone: TZ, hour12: false, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).formatToParts(d);\n    const get = (t) => Number(parts.find((p) => p.type === t).value);\n    if (get('year') === y && get('month') === mo + 1 && get('day') === day && get('hour') % 24 === h && get('minute') === mi) return d;\n  }\n  return new Date(Date.UTC(y, mo, day, h + 8, mi));\n}\n\nconst now = Date.now();\nconst minStart = now + 24 * 3600000;\nconst slots = [];\nconst cursor = new Date();\nlet businessDays = 0;\nfor (let i = 0; i < 20 && businessDays < 10; i++) {\n  const d = new Date(now + i * 86400000);\n  const parts = new Intl.DateTimeFormat('en-US', { timeZone: TZ, weekday: 'short', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(d);\n  const get = (t) => parts.find((p) => p.type === t).value;\n  const wd = get('weekday');\n  if (wd === 'Sat' || wd === 'Sun') continue;\n  businessDays++;\n  const y = Number(get('year')); const mo = Number(get('month')) - 1; const day = Number(get('day'));\n  for (let h = 10; h < 16; h++) {\n    for (const mi of [0, 30]) {\n      const start = wallClockToUtc(y, mo, day, h, mi);\n      const startMs = start.getTime();\n      const endMs = startMs + 30 * 60000;\n      if (startMs < minStart) continue;\n      const clash = busyRanges.some(([bs, be]) => startMs < be && endMs > bs);\n      if (clash) continue;\n      const label = new Intl.DateTimeFormat('en-US', { timeZone: TZ, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(start) + ' PT';\n      slots.push({ iso: start.toISOString(), label });\n    }\n  }\n}\nreturn [{ json: { slots: slots.slice(0, 60) } }];"
      },
