      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Validate the booking form.\nconst b = ($input.first().json || {}).body || {};\nconst required = ['name', 'company', 'phone', 'email', 'slot'];\nconst missing = required.filter((k) => !String(b[k] || '').trim());\nconst slotMs = Date.parse(b.slot || '');\nif (missing.length || Number.isNaN(slotMs)) {\n  return [{ json: { invalid: true, error: missing.length ? 'missing: ' + missing.join(', ') : 'bad slot timestamp' } }];\n}\nreturn [{ json: {\n  invalid: false,\n  name: String(b.name).trim(),\n  company: String(b.company).trim(),\n  phone: String(b.phone).trim(),\n  email: String(b.email).trim().toLowerCase(),\n  city: String(b.city || '').trim() || null,\n  notes: String(b.notes || '').trim() || null,\n  slot_start: new Date(slotMs).toISOString(),\n  slot_end: new Date(slotMs + 30 * 60000).toISOString(),\n} }];"
      },
