      "id": "f4000000-0000-4000-8000-000000000002",
      "name": "Get Busy Times",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        560
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "gcal-oauth2",
          "name": "Google Calendar account"
        }
