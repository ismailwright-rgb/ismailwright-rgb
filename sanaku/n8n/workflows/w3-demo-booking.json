    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fire the 24h reminder inside the [23h, 24h) window and the 1h reminder\n// inside (0, 1h] - the hourly cron hits each window exactly once.\nconst now = Date.now();\nconst out = [];\nfor (const i of $input.all()) {\n  const d = i.json;\n  if (!d || !d.id || !d.scheduled_for) continue;\n  const p = d.sanaku_prospects || {};\n  if (!p.contact_email) continue;\n  const deltaH = (new Date(d.scheduled_for).getTime() - now) / 3600000;\n  let kind = null;\n  if (deltaH > 23 && deltaH <= 24) kind = '24h';\n  else if (deltaH > 0 && deltaH <= 1) kind = '1h';\n  if (!kind) continue;\n  out.push({ json: {\n    email: p.contact_email,\n    name: (p.contact_name || '').split(' ')[0] || 'there',\n    company: p.company_name || '',\n    when: d.scheduled_for,\n    kind,\n  } });\n}\nreturn out;"
      },
