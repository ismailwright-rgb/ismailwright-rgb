        "url": "={{ $env.SUPABASE_URL }}/rest/v1/sanaku_clients?or=(inbound_number.eq.{{ encodeURIComponent($json.to) }},sending_number.eq.{{ encodeURIComponent($json.to) }})&select=*&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000003",
