    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalize the inbound message and detect an opt-out before anything else.\nconst b = ($input.first().json || {}).body || {};\nconst e164 = (v) => {\n  const d = String(v || '').replace(/[^\\d+]/g, '');\n  if (/^\\+\\d{10,15}$/.test(d)) return d;\n  if (/^1\\d{10}$/.test(d)) return '+' + d;\n  if (/^\\d{10}$/.test(d)) return '+1' + d;\n  return null;\n};\nconst from = e164(b.From || b.from || b.caller);\nconst to   = e164(b.To || b.to || b.called);\nconst text = String(b.Body || b.body || b.text || b.message || '').trim();\nconst isStop = /^\\s*(stop|stopall|unsubscribe|cancel|end|quit|remove me|opt ?out)\\b/i.test(text);\nif (!from || !to) {\n  return [{ json: { invalid: true } }];\n}\nreturn [{ json: { invalid: false, from, to, text, isStop } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Normalize Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        560
      ]
    },
    {
      "parameters": {
