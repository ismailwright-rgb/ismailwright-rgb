    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENROUTER_MODEL || 'meta-llama/llama-3.3-70b-instruct:free', messages: [ { role: 'system', content: 'You grade inbound text replies to a local service business. The business defines a QUALIFIED lead as: ' + ($('Find Client').first().json.qualified_definition || 'someone with a real need for the service who left a way to reach them, not spam, not a vendor, not a wrong number') + '. Reply with STRICT JSON only: {\"qualified\": true|false, \"score\": 0-100, \"urgent\": true|false, \"summary\": \"under 15 words\"}. urgent = they need help today (leak, outage, pain, emergency).' }, { role: 'user', content: $('Normalize Reply').first().json.text } ], max_tokens: 120, temperature: 0 }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Qualify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        700
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-header-auth",
          "name": "OpenRouter (Header Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 4000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse the grade; fall back to keywords so a model outage never drops a lead.\nconst reply = $('Normalize Reply').first().json;\nconst client = $('Find Client').first().json;\nlet lead = null;\ntry { lead = $('Find Open Lead').first().json; } catch (e) { lead = null; }\nif (lead && !lead.id) lead = null;\n\nlet g = null;\ntry {\n  const raw = $input.first().json.choices[0].message.content;\n  g = JSON.parse(String(raw).replace(/^\\s*```(?:json)?/i, '').replace(/```\\s*$/, ''));\n} catch (e) { g = null; }\n\nconst text = reply.text.toLowerCase();\nif (!g || typeof g.qualified !== 'boolean') {\n  // Conservative fallback: a substantive reply from someone who just called is\n  // almost always a real lead. Better to over-alert than to miss a customer.\n  const junk = /^(ok|k|thanks|thank you|no|nope|yes|y|👍|\\.|wrong number)\\.?$/i.test(reply.text.trim());\n  g = {\n    qualified: !junk && reply.text.trim().length > 3,\n    score: junk ? 10 : 60,\n    urgent: /emergency|urgent|asap|today|right now|leak|flood|no (heat|power|water|ac)|burst/.test(text),\n    summary: reply.text.slice(0, 60),\n  };\n}\nif (/emergency|urgent|asap|leak|flood|burst|no (heat|power|water)/.test(text)) g.urgent = true;\n\nconst convo = Array.isArray(lead?.conversation) ? lead.conversation : [];\nconvo.push({ dir: 'in', at: new Date().toISOString(), body: reply.text });\n\nreturn [{ json: {\n  lead_id: lead?.id || null,\n  client_id: client.id,\n  brand: client.brand_name || client.company_name,\n  from: reply.from,\n  qualified: !!g.qualified,\n  score: Math.max(0, Math.min(100, Number(g.score) || 0)),\n  urgent: !!g.urgent,\n  summary: String(g.summary || '').slice(0, 200),\n  conversation: convo,\n  escalation_phone: client.escalation_phone,\n  text: reply.text,\n} }];"
      },
