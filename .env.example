# ============================================================================
# AI Prospect Tiering Pipeline - environment variables & credentials
# ============================================================================
# This file documents every key the n8n workflows need. NEVER commit real
# values. Two kinds of secrets:
#   [env]  -> set as an n8n environment variable (Settings > Variables on
#             n8n Cloud, or the host/container environment when self-hosting)
#   [cred] -> entered ONLY in the n8n credentials UI (never stored as env)

# ---- Supabase --------------------------------------------------------------
# [env] Project URL from Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# [cred] service_role key -> n8n Header Auth credential
#        "Supabase Service Role (Header Auth)" (header name: apikey)
# SUPABASE_SERVICE_ROLE_KEY=do-not-put-this-in-env

# ---- Apollo ----------------------------------------------------------------
# [cred] API key -> n8n Header Auth credential
#        "Apollo API Key (Header Auth)" (header name: x-api-key)
# APOLLO_API_KEY=do-not-put-this-in-env

# ---- BuiltWith (OPTIONAL) --------------------------------------------------
# [env] Leave unset to skip BuiltWith enrichment entirely (recommended on the
#       free tier - the HTML scraper is the authoritative signal source).
BUILTWITH_API_KEY=

# ---- Vapi ------------------------------------------------------------------
# [cred] Private API key -> n8n Header Auth credential
#        "Vapi API Key (Header Auth)" (header: Authorization = Bearer <key>)
# VAPI_API_KEY=do-not-put-this-in-env

# [env] IDs from the Vapi dashboard
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# [env] Shared secret you invent; set the SAME value as the Server URL secret
#       on your Vapi assistant. Workflow 05 rejects webhooks without it.
VAPI_WEBHOOK_SECRET=

# ---- Email -----------------------------------------------------------------
# [env] Sender/recipient for the Tier 1 digest and notifications
DIGEST_FROM_EMAIL=you@yourdomain.com
DIGEST_TO_EMAIL=you@yourdomain.com

# [cred] SMTP host/port/user/password -> n8n SMTP credential "SMTP Account"
